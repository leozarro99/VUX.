// O ponto de entrada para a sua aplicação React, adaptada para Supabase
import React, { useState, useEffect } from 'react';

// Importação do Supabase - a nova API de base de dados
import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

// Função utilitária para converter a data do Supabase para uma string formatada
const formatDate = (dateString) => {
    if (!dateString) return '';
    const date = new Date(dateString);
    const options = { year: 'numeric', month: 'long', day: 'numeric' };
    return date.toLocaleDateString('pt-PT', options);
};

// Componente principal da aplicação
export default function App() {
    // Estados para gerir os dados da aplicação
    const [supabase, setSupabase] = useState(null); // Cliente Supabase
    const [userId, setUserId] = useState(null); // ID do utilizador (agora gerido localmente)
    const [isAuthReady, setIsAuthReady] = useState(false); // Estado de prontidão da autenticação
    const [receitas, setReceitas] = useState([]); // Array para receitas
    const [despesas, setDespesas] = useState([]); // Array para despesas
    const [isLoading, setIsLoading] = useState(true); // Estado de carregamento
    const [isAddingEntry, setIsAddingEntry] = useState(false); // Estado para o formulário de adição
    const [isEditingEntry, setIsEditingEntry] = useState(false); // Estado para o formulário de edição
    const [currentEntry, setCurrentEntry] = useState(null); // Entrada selecionada para edição
    const [formType, setFormType] = useState('receita'); // Tipo de formulário: 'receita' ou 'despesa'
    const [formDescricao, setFormDescricao] = useState(''); // Descrição do formulário
    const [formValor, setFormValor] = useState(''); // Valor do formulário
    const [error, setError] = useState(null); // Mensagem de erro

    // Lida com erros de forma mais graciosa
    const handleError = (err, message) => {
        console.error(message, err);
        setError(`${message}: ${err.message || err.toString()}`);
    };

    // Inicialização do Supabase e gestão do ID do utilizador
    useEffect(() => {
        try {
            // Inicializa o cliente Supabase com os valores fornecidos
            const supabaseUrl = 'https://mpcjuzvbzoaonhjlclmg.supabase.co';
            const supabaseAnonKey = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1wY2p1enZiem9hb25oamxjbG1nIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTU1NDg4OTUsImV4cCI6MjA3MTEyNDg5NX0.Pz2HuzmfY9czU_ckXzKi2flNAS71p1sqpWBxBb2b4sI';
            const supabaseClient = createClient(supabaseUrl, supabaseAnonKey);
            setSupabase(supabaseClient);

            // Gerir o ID do utilizador usando o localStorage
            let localUserId = localStorage.getItem('supabase-user-id');
            if (!localUserId) {
                localUserId = crypto.randomUUID();
                localStorage.setItem('supabase-user-id', localUserId);
            }
            setUserId(localUserId);
            setIsAuthReady(true);
        } catch (err) {
            handleError(err, 'Erro ao inicializar Supabase ou ao obter ID do utilizador');
            setIsLoading(false);
        }
    }, []);

    // Hook para carregar dados do Supabase e subscrever a atualizações em tempo real
    useEffect(() => {
        if (!isAuthReady || !supabase || !userId) {
            return;
        }

        let isReceitasSubscribed = false;
        let isDespesasSubscribed = false;

        // Função para verificar se ambos os carregamentos foram concluídos
        const checkBothLoaded = () => {
            if (isReceitasSubscribed && isDespesasSubscribed) {
                setIsLoading(false);
            }
        };

        // Subscrição em tempo real para receitas
        const receitasSubscription = supabase
            .channel('public:receitas')
            .on(
                'postgres_changes',
                { event: '*', schema: 'public', table: 'receitas' },
                async (payload) => {
                    // Recarrega todos os dados para garantir consistência
                    const { data, error } = await supabase.from('receitas').select('*').order('created_at', { ascending: false });
                    if (error) {
                        handleError(error, 'Erro ao recarregar receitas');
                    } else {
                        setReceitas(data);
                    }
                }
            )
            .subscribe((status) => {
                if (status === 'SUBSCRIBED') {
                    isReceitasSubscribed = true;
                    checkBothLoaded();
                }
            });

        // Subscrição em tempo real para despesas
        const despesasSubscription = supabase
            .channel('public:despesas')
            .on(
                'postgres_changes',
                { event: '*', schema: 'public', table: 'despesas' },
                async (payload) => {
                    const { data, error } = await supabase.from('despesas').select('*').order('created_at', { ascending: false });
                    if (error) {
                        handleError(error, 'Erro ao recarregar despesas');
                    } else {
                        setDespesas(data);
                    }
                }
            )
            .subscribe((status) => {
                if (status === 'SUBSCRIBED') {
                    isDespesasSubscribed = true;
                    checkBothLoaded();
                }
            });

        // Fetch inicial de dados para garantir que temos algo ao carregar
        const fetchInitialData = async () => {
            const { data: receitasData, error: receitasError } = await supabase.from('receitas').select('*').order('created_at', { ascending: false });
            if (receitasError) {
                handleError(receitasError, 'Erro ao carregar receitas iniciais');
            } else {
                setReceitas(receitasData);
            }
            
            const { data: despesasData, error: despesasError } = await supabase.from('despesas').select('*').order('created_at', { ascending: false });
            if (despesasError) {
                handleError(despesasError, 'Erro ao carregar despesas iniciais');
            } else {
                setDespesas(despesasData);
            }
        };
        fetchInitialData();


        // Retorna a função de limpeza para desativar os listeners
        return () => {
            supabase.removeChannel(receitasSubscription);
            supabase.removeChannel(despesasSubscription);
        };

    }, [isAuthReady, supabase, userId]);

    // Calcula o saldo total
    const saldo = receitas.reduce((sum, r) => sum + (r.valor || 0), 0) - despesas.reduce((sum, d) => sum + (d.valor || 0), 0);

    // Adiciona uma nova entrada (receita ou despesa)
    const handleAddEntry = async (e) => {
        e.preventDefault();
        setIsLoading(true);
        setError(null);

        if (!formDescricao || !formValor || isNaN(parseFloat(formValor))) {
            setError('Por favor, preencha a descrição e o valor.');
            setIsLoading(false);
            return;
        }

        try {
            const tableName = formType === 'receita' ? 'receitas' : 'despesas';
            const { error: insertError } = await supabase
                .from(tableName)
                .insert({
                    descricao: formDescricao,
                    valor: parseFloat(formValor),
                    user_id: userId // Necessário para as políticas RLS
                });

            if (insertError) {
                handleError(insertError, `Erro ao adicionar a entrada`);
            } else {
                setFormDescricao('');
                setFormValor('');
                setIsAddingEntry(false);
            }
        } catch (err) {
            handleError(err, `Erro ao adicionar a entrada`);
        } finally {
            setIsLoading(false);
        }
    };

    // Inicia o processo de edição de uma entrada
    const handleEditClick = (entry, type) => {
        setIsEditingEntry(true);
        setIsAddingEntry(false);
        setCurrentEntry(entry);
        setFormType(type);
        setFormDescricao(entry.descricao);
        setFormValor(entry.valor);
        setError(null);
    };

    // Atualiza uma entrada existente
    const handleUpdateEntry = async (e) => {
        e.preventDefault();
        setIsLoading(true);
        setError(null);

        if (!currentEntry || !formDescricao || !formValor || isNaN(parseFloat(formValor))) {
            setError('Por favor, preencha a descrição e o valor para atualizar.');
            setIsLoading(false);
            return;
        }

        try {
            const tableName = formType === 'receita' ? 'receitas' : 'despesas';
            const { error: updateError } = await supabase
                .from(tableName)
                .update({
                    descricao: formDescricao,
                    valor: parseFloat(formValor),
                })
                .eq('id', currentEntry.id);

            if (updateError) {
                handleError(updateError, 'Erro ao atualizar a entrada');
            } else {
                setIsEditingEntry(false);
                setCurrentEntry(null);
                setFormDescricao('');
                setFormValor('');
            }
        } catch (err) {
            handleError(err, 'Erro ao atualizar a entrada');
        } finally {
            setIsLoading(false);
        }
    };

    // Deleta uma entrada
    const handleDeleteEntry = async (entry, type) => {
        // Substituir alert/confirm por uma modal
        if (window.confirm(`Tem certeza de que deseja excluir ${entry.descricao}?`)) {
            setIsLoading(true);
            setError(null);
            try {
                const tableName = type === 'receita' ? 'receitas' : 'despesas';
                const { error: deleteError } = await supabase
                    .from(tableName)
                    .delete()
                    .eq('id', entry.id);

                if (deleteError) {
                    handleError(deleteError, 'Erro ao excluir a entrada');
                }
            } catch (err) {
                handleError(err, 'Erro ao excluir a entrada');
            } finally {
                setIsLoading(false);
            }
        }
    };

    // Componente de carregamento
    const LoadingSpinner = () => (
        <div className="flex justify-center items-center h-full">
            <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-gray-900"></div>
            <p className="ml-2">A carregar...</p>
        </div>
    );

    // Interface do utilizador
    return (
        <div className="min-h-screen bg-gray-100 p-4 font-sans flex flex-col items-center">
            <h1 className="text-3xl font-bold text-gray-800 mb-6">Controlo de Finanças Pessoais</h1>

            {/* Exibe o ID do utilizador para depuração */}
            <div className="mb-4 text-sm text-gray-600">
                <span className="font-semibold">ID do Utilizador:</span> {userId ? userId : 'A carregar...'}
            </div>

            {/* Exibe erros se houverem */}
            {error && (
                <div className="bg-red-200 text-red-800 p-3 rounded-lg w-full max-w-2xl mb-4 text-center shadow-md">
                    <p>{error}</p>
                </div>
            )}

            {/* Saldo Total */}
            <div className="bg-white p-6 rounded-2xl shadow-xl w-full max-w-2xl mb-8 border border-gray-200">
                <h2 className="text-xl font-semibold text-gray-700">Saldo Total</h2>
                <p className={`text-4xl font-extrabold mt-2 ${saldo >= 0 ? 'text-green-600' : 'text-red-600'}`}>
                    €{saldo.toFixed(2)}
                </p>
            </div>

            {/* Botões para adicionar ou fechar o formulário */}
            <div className="flex space-x-4 mb-8">
                <button
                    onClick={() => {
                        setIsAddingEntry(true);
                        setIsEditingEntry(false);
                        setFormType('receita');
                        setFormDescricao('');
                        setFormValor('');
                        setError(null);
                    }}
                    className="bg-green-500 text-white px-6 py-3 rounded-xl font-semibold hover:bg-green-600 transition-colors shadow-lg"
                >
                    + Adicionar Receita
                </button>
                <button
                    onClick={() => {
                        setIsAddingEntry(true);
                        setIsEditingEntry(false);
                        setFormType('despesa');
                        setFormDescricao('');
                        setFormValor('');
                        setError(null);
                    }}
                    className="bg-red-500 text-white px-6 py-3 rounded-xl font-semibold hover:bg-red-600 transition-colors shadow-lg"
                >
                    + Adicionar Despesa
                </button>
            </div>

            {/* Formulário de Adição/Edição */}
            {(isAddingEntry || isEditingEntry) && (
                <div className="bg-white p-6 rounded-2xl shadow-xl w-full max-w-2xl mb-8 border border-gray-200">
                    <h2 className="text-2xl font-semibold text-gray-800 mb-4">{isEditingEntry ? 'Editar' : 'Adicionar Nova'} {formType === 'receita' ? 'Receita' : 'Despesa'}</h2>
                    <form onSubmit={isEditingEntry ? handleUpdateEntry : handleAddEntry} className="space-y-4">
                        <input
                            type="text"
                            placeholder="Descrição"
                            value={formDescricao}
                            onChange={(e) => setFormDescricao(e.target.value)}
                            className="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                            required
                        />
                        <input
                            type="number"
                            placeholder="Valor"
                            value={formValor}
                            onChange={(e) => setFormValor(e.target.value)}
                            className="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                            required
                        />
                        <div className="flex space-x-4">
                            <button
                                type="submit"
                                className="w-1/2 bg-blue-500 text-white px-6 py-3 rounded-xl font-semibold hover:bg-blue-600 transition-colors shadow-lg"
                                disabled={isLoading}
                            >
                                {isLoading ? 'A guardar...' : isEditingEntry ? 'Atualizar' : 'Adicionar'}
                            </button>
                            <button
                                type="button"
                                onClick={() => {
                                    setIsAddingEntry(false);
                                    setIsEditingEntry(false);
                                    setError(null);
                                }}
                                className="w-1/2 bg-gray-300 text-gray-800 px-6 py-3 rounded-xl font-semibold hover:bg-gray-400 transition-colors shadow-lg"
                            >
                                Cancelar
                            </button>
                        </div>
                    </form>
                </div>
            )}

            {isLoading && !error ? (
                <LoadingSpinner />
            ) : (
                <div className="grid grid-cols-1 md:grid-cols-2 gap-8 w-full max-w-4xl">
                    {/* Lista de Receitas */}
                    <div className="bg-white p-6 rounded-2xl shadow-xl border border-gray-200">
                        <h2 className="text-2xl font-bold text-green-600 mb-4">Receitas</h2>
                        {receitas.length === 0 ? (
                            <p className="text-gray-500 text-center">Nenhuma receita adicionada ainda.</p>
                        ) : (
                            <ul className="space-y-4">
                                {receitas.map((receita) => (
                                    <li key={receita.id} className="flex items-center justify-between p-4 bg-green-50 rounded-lg shadow-sm">
                                        <div>
                                            <p className="font-semibold text-gray-800">{receita.descricao}</p>
                                            <p className="text-sm text-gray-500">{formatDate(receita.created_at)}</p>
                                        </div>
                                        <div className="flex items-center space-x-4">
                                            <span className="text-lg font-bold text-green-700">€{receita.valor.toFixed(2)}</span>
                                            <button onClick={() => handleEditClick(receita, 'receita')} className="text-blue-500 hover:text-blue-700 transition-colors">
                                                <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                                    <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zm-3.88 3.88a1 1 0 010 1.414L6.96 11.414a1 1 0 01-1.414 0L3.586 9.414a1 1 0 010-1.414l2.828-2.828a1 1 0 011.414 0l3.88 3.88z" />
                                                </svg>
                                            </button>
                                            <button onClick={() => handleDeleteEntry(receita, 'receita')} className="text-red-500 hover:text-red-700 transition-colors">
                                                <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                                    <path fillRule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clipRule="evenodd" />
                                                </svg>
                                            </button>
                                        </div>
                                    </li>
                                ))}
                            </ul>
                        )}
                    </div>

                    {/* Lista de Despesas */}
                    <div className="bg-white p-6 rounded-2xl shadow-xl border border-gray-200">
                        <h2 className="text-2xl font-bold text-red-600 mb-4">Despesas</h2>
                        {despesas.length === 0 ? (
                            <p className="text-gray-500 text-center">Nenhuma despesa adicionada ainda.</p>
                        ) : (
                            <ul className="space-y-4">
                                {despesas.map((despesa) => (
                                    <li key={despesa.id} className="flex items-center justify-between p-4 bg-red-50 rounded-lg shadow-sm">
                                        <div>
                                            <p className="font-semibold text-gray-800">{despesa.descricao}</p>
                                            <p className="text-sm text-gray-500">{formatDate(despesa.created_at)}</p>
                                        </div>
                                        <div className="flex items-center space-x-4">
                                            <span className="text-lg font-bold text-red-700">€{despesa.valor.toFixed(2)}</span>
                                            <button onClick={() => handleEditClick(despesa, 'despesa')} className="text-blue-500 hover:text-blue-700 transition-colors">
                                                <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                                    <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zm-3.88 3.88a1 1 0 010 1.414L6.96 11.414a1 1 0 01-1.414 0L3.586 9.414a1 1 0 010-1.414l2.828-2.828a1 1 0 011.414 0l3.88 3.88z" />
                                                </svg>
                                            </button>
                                            <button onClick={() => handleDeleteEntry(despesa, 'despesa')} className="text-red-500 hover:text-red-700 transition-colors">
                                                <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                                    <path fillRule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clipRule="evenodd" />
                                                </svg>
                                            </button>
                                        </div>
                                    </li>
                                ))}
                            </ul>
                        )}
                    </div>
                </div>
            )}
        </div>
    );
}
